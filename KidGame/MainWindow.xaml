<Window x:Class="KidGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
         
        Title="SelectGame" Height="Auto" Width="Auto"  WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" HorizontalContentAlignment="Left" FlowDirection="LeftToRight" MinWidth="550" MinHeight="370" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DesignHeight="370" d:DesignWidth="550" SizeToContent="WidthAndHeight">
        
    <Window.Background>
        <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
            <GradientStop Color="#FF968B92" Offset="0" />
            <GradientStop Color="#FFEBCACA" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30*" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="47" />
            <ColumnDefinition Width="122" />
            <ColumnDefinition Width="47" />
            <ColumnDefinition Width="122" />
            <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="79*" />
            <RowDefinition Height="82" />
            <RowDefinition Height="117" />
            <RowDefinition Height="17*" />
        </Grid.RowDefinitions>
        <Grid  Name="gridMenu" FlowDirection="LeftToRight" Grid.ColumnSpan="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Menu HorizontalAlignment="Stretch" Name="menu1" VerticalAlignment="Stretch" Width="Auto" HorizontalContentAlignment="Right" FontSize="18" FlowDirection="RightToLeft" VerticalContentAlignment="Stretch" BorderThickness="1" Opacity="1" OpacityMask="{x:Null}">
                <MenuItem Header="فایل" FlowDirection="RightToLeft">
                    <MenuItem Header="خروج" Name="exit" Click="exit_Click" >
                        <MenuItem.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF95A2E8" Offset="0" />
                                <GradientStop Color="White" Offset="1" />
                            </LinearGradientBrush>
                        </MenuItem.Background>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="تنظیمات" FlowDirection="RightToLeft">
                    <MenuItem Header="ذخیره کلمه" Name="menuItemSaveWord" Click="menuItemSaveWord_Click">
                        <MenuItem.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF95A2E8" Offset="0" />
                                <GradientStop Color="White" Offset="1" />
                            </LinearGradientBrush>
                        </MenuItem.Background>
                    </MenuItem>
                    <MenuItem Header="ثبت بازیکن" Name="menuItemProfile" Click="menuItemProfile_Click" >
                        <MenuItem.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF95A2E8" Offset="0" />
                                <GradientStop Color="White" Offset="1" />
                            </LinearGradientBrush>
                        </MenuItem.Background>
                    </MenuItem>
                    <MenuItem Header="ثبت تصویر" Name="menuItemSavePic" Click="menuItemSavePic_Click" >
                        <MenuItem.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF95A2E8" Offset="0" />
                                <GradientStop Color="White" Offset="1" />
                            </LinearGradientBrush>
                        </MenuItem.Background>
                    </MenuItem>

                </MenuItem>
                <Menu.Background>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="#FFD0D8E8" Offset="0.206" />
                        <GradientStop Color="#FF444F7C" Offset="1" />
                    </LinearGradientBrush>
                </Menu.Background>
                <Menu.BorderBrush>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="#FFB6E5C2" Offset="0" />
                        <GradientStop Color="#FF2A5835" Offset="0.847" />
                    </LinearGradientBrush>
                </Menu.BorderBrush>
            </Menu>
        </Grid>
        <Grid Name="gridCmb" Grid.Column="5" Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="18,75,0,9">
            <ComboBox  ItemsSource="{Binding}" HorizontalAlignment="Stretch" Margin="0" Name="cmbPlayer" VerticalAlignment="Stretch" FontSize="16" HorizontalContentAlignment="Center" MinWidth="0" MinHeight="0" Padding="0" IsEditable="True" IsReadOnly="True">
                <ComboBox.Background>
                    <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                        <GradientStop Color="#FFA07B7B" Offset="0" />
                        <GradientStop Color="White" Offset="1" />
                    </LinearGradientBrush>
                </ComboBox.Background>
            </ComboBox>
            <Grid.Background>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#FF82A2EB" Offset="0" />
                    <GradientStop Color="#FFC8D0E5" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
            
            <Grid Name="gridbtn" Margin="0" Grid.Column="3" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          
            <Button Content=" تصاویر همانند" Height="Auto" HorizontalAlignment="Stretch" Name="btn_PicSimilar" VerticalAlignment="Stretch" Width="Auto" Click="btn_PicSimilar_Click" FontSize="16" Style="{StaticResource ButtonStyle2}" Margin="0" />
        </Grid>
        <Grid Name="gridNamePic" Grid.Column="5" Margin="0" Grid.Row="2">
        <Button Content=" نام تصویر" FontSize="16" HorizontalAlignment="Stretch" Name="btnPicName" VerticalAlignment="Stretch" Click="btnPicName_Click" Margin="0" Style="{StaticResource ButtonStyle2}" />
        </Grid>
        
        <Grid Name="gridWord" Grid.Row="2" Grid.Column="1">
        <Button Content="حروف کلمات" FontSize="16" HorizontalAlignment="Stretch" Name="btnAlphaWord" VerticalAlignment="Stretch" Click="btnAlphaWord_Click" Margin="0" Style="{StaticResource ButtonStyle2}" />
        </Grid>
    </Grid>
</Window>
