<Window x:Class="KidGame.AlphabetWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlphabetWord" Loaded="Window_Loaded" Closing="Window_Closing" WindowStartupLocation="CenterScreen" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" MinWidth="700" MinHeight="600" d:DesignHeight="539" d:DesignWidth="700" SizeToContent="WidthAndHeight">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="White" Offset="0" />
            <GradientStop Color="#FF625B5B" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid Height="Auto" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26*" />
            <ColumnDefinition Width="87*" />
            <ColumnDefinition Width="115*" />
            <ColumnDefinition Width="261*" />
            <ColumnDefinition Width="84*" />
            <ColumnDefinition Width="79*" />
            <ColumnDefinition Width="26*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="51*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="72*" />
            <RowDefinition Height="180*" />
            <RowDefinition Height="34*" />
        </Grid.RowDefinitions>
        <Grid Height="Auto" HorizontalAlignment="Stretch" Name="gridStart" VerticalAlignment="Stretch" Width="Auto" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22*" />
            </Grid.RowDefinitions>
            <Label Content="نام بازیکن" FontSize="15" Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Margin="3" Name="label1" VerticalAlignment="Stretch" Width="Auto" Padding="5" HorizontalContentAlignment="Stretch" MinHeight="50" VerticalContentAlignment="Top" />
            <TextBlock FontFamily="zar"  FontSize="16" Foreground="#FF1453E2" Height="Auto" HorizontalAlignment="Stretch" Name="txtbNamePlayer" Text="Name" TextAlignment="Right" VerticalAlignment="Stretch" Width="Auto" MinHeight="50" MinWidth="57" Margin="0,5,5,5" Padding="5" />
            <Button Click="btnStartGame_Click" Content="شروع بازی" Grid.Column="2" HorizontalAlignment="Stretch" Name="btnStartGame" VerticalAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle2}" Grid.Row="1" Margin="3,3,0,7" FontSize="14" Padding="0" MinWidth="80" MinHeight="35" Height="Auto" />
            <Label Content="انصراف" FontSize="15" Foreground="#FFCB1212" Height="Auto" HorizontalAlignment="Stretch" Margin="0,7" MouseDown="lblCancel_MouseDown" Name="lblCancel" VerticalAlignment="Stretch" VerticalContentAlignment="Center" MouseEnter="lblCancel_MouseEnter" MouseLeave="lblCancel_MouseLeave" Padding="5" Grid.Row="1" MinWidth="50" />
            <Grid Height="Auto" HorizontalAlignment="Stretch" Margin="0,10,0,5" Name="gridRdioBtn" VerticalAlignment="Stretch" Grid.Column="2" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="14*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12*" />
                </Grid.RowDefinitions>
                <RadioButton Checked="radibtnNormal_Checked" Content="سخت" IsChecked="False" Margin="0" Name="radibtnNormal" Padding="4" Height="Auto" VerticalAlignment="Bottom" Grid.Row="3" VerticalContentAlignment="Center" />
                <RadioButton Checked="radibtnEasy_Checked" Content="ساده" IsChecked="True" IsEnabled="True" Margin="0" Name="radibtnEasy" Padding="4" Height="Auto" VerticalAlignment="Stretch" Grid.Row="1" HorizontalContentAlignment="Stretch" FlowDirection="LeftToRight" VerticalContentAlignment="Center" />
            </Grid>
        </Grid>
        <Grid Height="Auto" HorizontalAlignment="Center" Name="gridScore" VerticalAlignment="Stretch" Width="Auto" Grid.ColumnSpan="3" Margin="20,0,5,0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="0*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="47*" />
            </Grid.ColumnDefinitions>
            <Label Content="دور" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,5,5,0" Name="lblRound" VerticalAlignment="Top" VerticalContentAlignment="Center" Width="Auto" Grid.Column="3" Grid.Row="2" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="0,5,5,0" Name="txtScore" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" MinHeight="30" MinWidth="50" Padding="2" />
            <Label Content="امتیاز" Height="Auto" HorizontalAlignment="Stretch" Margin="0,5,5,0" Name="lblScore" VerticalAlignment="Top" Width="Auto" Grid.Column="3" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="0,5,5,5" Name="txtRound" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="2" VerticalContentAlignment="Center" MinWidth="50" MinHeight="30" Padding="2" />
            <Label Content="زمان باقیمانده" Height="Auto" HorizontalAlignment="Stretch" Margin="0,5,5,5" Name="lblTime" VerticalAlignment="Stretch" Width="Auto" Grid.Column="3" HorizontalContentAlignment="Center" Padding="0" VerticalContentAlignment="Center" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="0,10,5,5" Name="txtTime" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" VerticalContentAlignment="Center" MinWidth="50" MinHeight="30" Padding="2" />
            <Button Click="btnGift_Click" Content="-&gt;" Height="Auto" HorizontalAlignment="Stretch" Margin="5,10,5,5" Name="btnGift" VerticalAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle2}" Grid.Column="1" MinWidth="30" MinHeight="30" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="5,10,0,5" Name="txtGift" VerticalAlignment="Stretch" Width="Auto" MinWidth="30" MinHeight="30" VerticalContentAlignment="Center" Padding="2" />
            <Label Content="مقایسه" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,5,5,5" Name="label2" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Width="Auto" Grid.Column="3" Grid.Row="3" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="0,5,5,5" Name="txtNumberWord" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="3" VerticalContentAlignment="Center" Padding="2" MinHeight="30" MinWidth="50" />
        </Grid>
        <Grid Name="gridTxtWord" Grid.Column="3" Grid.RowSpan="2" Margin="0">
            
            <TextBlock FlowDirection="LeftToRight"  FontSize="36" Foreground="#FF0C0C5F" Height="Auto" HorizontalAlignment="Center" Margin="0,0,0,30" Name="TxtBlChangeName" Text="" TextAlignment="Center" VerticalAlignment="Bottom" Width="Auto" TextWrapping="NoWrap" MinWidth="20" MinHeight="15" Grid.Row="1" />
        </Grid>
        <UniformGrid Columns="8" FlowDirection="RightToLeft" Grid.ColumnSpan="3" Name="gridWord" Rows="4" Grid.Row="3" Grid.Column="2" PreviewMouseDown="gridWord_PreviewMouseDown" MouseDown="gridWord_MouseDown" MouseLeftButtonDown="gridWord_MouseLeftButtonDown" MouseUp="gridWord_MouseUp" PreviewMouseUp="gridWord_PreviewMouseUp" MaxWidth="588" MaxHeight="250" MinWidth="420" MinHeight="210">
            <Button Content="الف"  FontSize="22" FontWeight="Bold" Height="Auto" Name="button1" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ب"  FontWeight="Bold" Height="Auto" IsEnabled="True" Name="button2" UseLayoutRounding="True" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" HorizontalContentAlignment="Center" FlowDirection="RightToLeft" HorizontalAlignment="Stretch" FontSize="28" VerticalAlignment="Stretch" />
            <Button Content="پ" FontSize="28" FontWeight="Bold" Height="Auto" HorizontalContentAlignment="Center" Name="button3" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ت" FontSize="28" FontWeight="Bold" Height="Auto" Name="button4" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ث" FontSize="28" FontWeight="Bold" Height="Auto" Name="button5" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ج" FontSize="28" FontWeight="Bold" Height="Auto" Name="button6" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="چ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button7" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ح" FontSize="28" FontWeight="Bold" Height="Auto" Name="button8" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="خ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button9" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="د" FontSize="28" FontWeight="Bold" Height="Auto" Name="button10" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ذ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button11" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ر" FontSize="28" FontWeight="Bold" Height="Auto" Name="button12" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ز" FontSize="28" FontWeight="Bold" Height="Auto" Name="button13" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ژ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button14" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="س" FontSize="28" FontWeight="Bold" Height="Auto" Name="button15" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ش" FontSize="28" FontWeight="Bold" Height="Auto" Name="button16" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ص" FontSize="28" FontWeight="Bold" Height="Auto" Name="button17" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ض" FontSize="28" FontWeight="Bold" Height="Auto" Name="button18" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ط" FontSize="28" FontWeight="Bold" Height="Auto" Name="button19" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" HorizontalContentAlignment="Center" Padding="1" />
            <Button Content="ظ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button20" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ع" FontSize="28" FontWeight="Bold" Height="Auto" Name="button21" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="غ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button22" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ف" FontSize="28" FontWeight="Bold" Height="Auto" Name="button23" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ق" FontSize="28" FontWeight="Bold" Height="Auto" Name="button24" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ک" FontSize="28" FontWeight="Bold" Height="Auto" Name="button25" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="گ" FontSize="28" FontWeight="Bold" Height="Auto" Name="button26" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ل" FontSize="28" FontWeight="Bold" Height="Auto" Name="button27" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="م" FontSize="28" FontWeight="Bold" Height="Auto" Name="button28" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ن" FontSize="28" FontWeight="Bold" Height="Auto" Name="button29" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="و" FontSize="28" FontWeight="Bold" Height="Auto" Name="button30" VerticalContentAlignment="Stretch" Width="Auto" Style="{StaticResource ButtonStyle1}" />
            <Button Content="ه" FontSize="28" FontWeight="Bold" Height="Auto" Name="button31" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" Padding="1" />
            <Button Content="ی" FontSize="28" FontWeight="Bold" Height="Auto" Name="button32" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle1}" />
        </UniformGrid>
    </Grid>
   
</Window>
