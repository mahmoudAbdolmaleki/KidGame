<Window x:Class="KidGame.SaveWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveWord" Height="423" Width="622" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFBDAFAF" Offset="0" />
            <GradientStop Color="#FF413D3D" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38*" />
            <ColumnDefinition Width="538*" />
            <ColumnDefinition Width="24*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="9*" />
            <RowDefinition Height="243*" />
            <RowDefinition Height="117*" />
            <RowDefinition Height="15*" />
        </Grid.RowDefinitions>
        <Grid Name="gridSave" Grid.Column="1" Margin="0" Grid.Row="2" HorizontalAlignment="Center" Width="443">
            <Grid.RowDefinitions>
                <RowDefinition Height="66*" />
                <RowDefinition Height="51*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="89*" />
                <ColumnDefinition Width="13" />
                <ColumnDefinition Width="26" />
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="134*" />
                <ColumnDefinition Width="139*" />
            </Grid.ColumnDefinitions>
            <TextBox Height="41" HorizontalAlignment="Center"  Margin="0" Name="txtWord" VerticalAlignment="Center" Width="120" IsReadOnly="True" FontSize="24" TextAlignment="Left" HorizontalContentAlignment="Right" FlowDirection="RightToLeft" TabIndex="0" FontWeight="Normal" AcceptsTab="False" MaxLength="0" Grid.Column="4" />
        <Button Content="ثبت" FontSize="16" FontWeight="Bold" Height="36" HorizontalAlignment="Center" Margin="0" Name="btnSave" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="109" Click="btnSave_Click" Style="{StaticResource ButtonStyle3}" Foreground="White" Grid.Column="4" Grid.Row="1" />
        <ComboBox FontSize="16" Height="32" HorizontalAlignment="Right" HorizontalContentAlignment="Right" ItemsSource="{Binding}" Margin="0,17,2,17" Name="cmbWord" VerticalAlignment="Center" Width="Auto" IsEditable="True" IsReadOnly="False" />
        <Button Content="-&gt;" Height="33" HorizontalAlignment="Center" Margin="0" Name="btnWordEdit" VerticalAlignment="Center" Width="28" Click="btnWordEdit_Click" Style="{StaticResource ButtonStyle3}" Foreground="White" Grid.Column="2" />
            <Button Content="کلمه جدید" FontSize="16" FontWeight="Bold" Foreground="White" Height="36" HorizontalAlignment="Center" Margin="0" Name="btnNewWord" Style="{StaticResource ButtonStyle3}" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="109" Grid.Column="5" Click="btnNewWord_Click" />
        </Grid>

        <Grid Margin="4,3,8,11" Name="gridWord" PreviewMouseDown="gridWord_PreviewMouseDown" Grid.Row="1" Grid.Column="1" MaxWidth="700" MaxHeight="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
                <ColumnDefinition Width="12*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20*" />
                <RowDefinition Height="20*" />
                <RowDefinition Height="20*" />
                <RowDefinition Height="20*" />
                <RowDefinition Height="20*" />
            </Grid.RowDefinitions>
            <Button Content="الف" FontSize="24" FontWeight="Bold" Grid.Column="7" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button1" Padding="5" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ب" FontSize="28" FontWeight="Bold" Grid.Column="6" Height="Auto" HorizontalAlignment="Stretch" IsEnabled="True" Margin="2" Name="button2" Padding="1" UseLayoutRounding="True" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="پ" FontSize="28" FontWeight="Bold" Grid.Column="5" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2" Name="button3" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ت" FontSize="28" FontWeight="Bold" Grid.Column="4" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button4" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ث" FontSize="28" FontWeight="Bold" Grid.Column="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button5" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ج" FontSize="28" FontWeight="Bold" Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button6" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="چ" FontSize="28" FontWeight="Bold" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button7" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ح" FontSize="28" FontWeight="Bold" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button8" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="خ" FontSize="28" FontWeight="Bold" Grid.Column="7" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button9" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="د" FontSize="28" FontWeight="Bold" Grid.Column="6" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button10" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ذ" FontSize="28" FontWeight="Bold" Grid.Column="5" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button11" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ر" FontSize="28" FontWeight="Bold" Grid.Column="4" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button12" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ز" FontSize="28" FontWeight="Bold" Grid.Column="3" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button13" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ژ" FontSize="28" FontWeight="Bold" Grid.Column="2" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button14" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="س" FontSize="28" FontWeight="Bold" Grid.Column="1" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button15" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ش" FontSize="28" FontWeight="Bold" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button16" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ص" FontSize="28" FontWeight="Bold" Grid.Column="7" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button17" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ض" FontSize="28" FontWeight="Bold" Grid.Column="6" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button18" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ط" FontSize="28" FontWeight="Bold" Grid.Column="5" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button19" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ظ" FontSize="28" FontWeight="Bold" Grid.Column="4" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button20" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ع" FontSize="28" FontWeight="Bold" Grid.Column="3" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button21" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="غ" FontSize="28" FontWeight="Bold" Grid.Column="2" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button22" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ف" FontSize="28" FontWeight="Bold" Grid.Column="1" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button23" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ق" FontSize="28" FontWeight="Bold" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button24" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ک" FontSize="28" FontWeight="Bold" Grid.Column="7" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button25" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="گ" FontSize="28" FontWeight="Bold" Grid.Column="6" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button26" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ل" FontSize="28" FontWeight="Bold" Grid.Column="5" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button27" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="م" FontSize="28" FontWeight="Bold" Grid.Column="4" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button28" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ن" FontSize="28" FontWeight="Bold" Grid.Column="3" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button29" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="و" FontSize="28" FontWeight="Bold" Grid.Column="2" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button30" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ه" FontSize="28" FontWeight="Bold" Grid.Column="1" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button31" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="ی" FontSize="28" FontWeight="Bold" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button32" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="فاصله" FontSize="22" FontWeight="Bold" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="4" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button33" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="حذف" FontSize="22" FontWeight="Bold" Grid.Column="6" Grid.ColumnSpan="2" Grid.Row="4" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button34" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" Style="{StaticResource ButtonStyle3}" Foreground="White" />
            <Button Content="آ" FontSize="28" FontWeight="Bold" Grid.Row="4" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="button35" Padding="1" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Style="{StaticResource ButtonStyle3}" Foreground="White" />
        </Grid>
    </Grid>
</Window>
