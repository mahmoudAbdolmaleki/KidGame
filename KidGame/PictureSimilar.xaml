<Window x:Class="KidGame.PictureSimilar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="zar" FontSize="18"
        Title="PictureSimilar" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" WindowState="Normal" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DesignHeight="510" d:DesignWidth="600" SizeToContent="WidthAndHeight" Closing="Window_Closing" MinWidth="620" MinHeight="560" Left="Auto" Top="Auto" HorizontalContentAlignment="Left" FlowDirection="LeftToRight">
    <Grid Name="gridMaster" Width="Auto" Height="Auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Name="gridImgChange" VerticalAlignment="Bottom" Height="80" Margin="49,0,45,46" Width="80" HorizontalAlignment="Center" Grid.Column="2" Focusable="False" ForceCursor="False" ShowGridLines="True" Grid.Row="1">
           
            <Image Height="Auto" HorizontalAlignment="Stretch" Name="imgChange" Stretch="Fill" VerticalAlignment="Stretch" Width="Auto" ClipToBounds="False" DataContext="{Binding}" Focusable="False" IsManipulationEnabled="False" AllowDrop="False" Grid.ColumnSpan="3" Grid.RowSpan="3" />
        </Grid>

        <Grid  HorizontalAlignment="Stretch" Name="gridStart" VerticalAlignment="Stretch" Grid.Column="3" Height="Auto" Margin="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Content="نام بازیکن" Height="Auto"  HorizontalAlignment="Center" Name="label1" VerticalAlignment="Top" FontSize="14" FontFamily="Seqoe UI"  Width="Auto" Grid.Column="1" MinWidth="90" HorizontalContentAlignment="Center" MinHeight="50" />
            <TextBlock FontFamily="Seqoe UI" FontSize="16" HorizontalAlignment="Stretch" Name="txtbNamePlayer" Text="Name" VerticalAlignment="Top" TextAlignment="Right" Foreground="#FF1453E2" Height="Auto" Width="Auto" MinHeight="50" Padding="5"></TextBlock>

        <Button Content="شروع بازی" FontFamily="Seqoe UI" FontSize="14" Height="Auto" HorizontalAlignment="Stretch" Name="btnStartGame" VerticalAlignment="Stretch" Click="btnStartGame_Click" Grid.Row="1" Style="{StaticResource ButtonStyle2}" Grid.Column="1" />


        <Grid HorizontalAlignment="Stretch" Name="gridRdioBtn" VerticalAlignment="Stretch" Width="Auto" Grid.Column="1" Grid.Row="2" Grid.RowSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <RadioButton Content="سخت" FontFamily="Seqoe UI" FontSize="14" Name="radibtnNormal" IsChecked="False" Checked="radibtnNormal_Checked" Padding="10" VerticalContentAlignment="Center" Margin="0" Grid.Row="1" />

                <RadioButton Content="ساده" FontFamily="Seqoe UI" FontSize="14" Name="radibtnEasy" IsChecked="False" Margin="0" IsEnabled="True" Checked="radibtnEasy_Checked" Padding="10" VerticalContentAlignment="Center" />

        </Grid>
            <Label Content="انصراف"  FontFamily="Seqoe UI"  Height="Auto" HorizontalAlignment="Center" Margin="0" Name="lblCancel" VerticalAlignment="Center" MouseDown="lblCancel_MouseDown" FontSize="15" Foreground="#FFCB1212" Grid.Row="1" VerticalContentAlignment="Center" MouseEnter="lblCancel_MouseEnter" MouseLeave="lblCancel_MouseLeave" Width="Auto" MinWidth="85" MinHeight="37" HorizontalContentAlignment="Center" />
        </Grid>
        <Grid HorizontalAlignment="Stretch" Margin="0" Name="gridScore" VerticalAlignment="Stretch" Width="Auto" Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                
            </Grid.RowDefinitions>
            <Label Content="دور" FontFamily="Seqoe UI" FontSize="14" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="lblRound" VerticalAlignment="Stretch" Width="Auto" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" Grid.Row="2" Grid.Column="3" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" Margin="10,5,0,5" Name="txtScore" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" FontSize="14" Grid.Row="1" Grid.Column="2" MinWidth="40" MinHeight="25" VerticalContentAlignment="Center" Padding="1" />
            <Label Content="امتیاز" FontFamily="Seqoe UI" FontSize="14" Height="Auto" HorizontalAlignment="Stretch" Margin="1,1,0,0" Name="lblScore" VerticalAlignment="Stretch" Width="Auto" Grid.Row="1" Grid.Column="3" />
            <TextBox Height="25" FontFamily="Seqoe UI" FontSize="14" Margin="10,5,0,5" Name="txtRound" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" Grid.Row="2" Grid.Column="2" MinWidth="40" MinHeight="25" VerticalContentAlignment="Center" Padding="1" />
            <Label Content="زمان باقیمانده" FontFamily="Seqoe UI" FontSize="14"  Height="Auto" HorizontalAlignment="Left" Margin="1,6,0,0" Name="lblTime" VerticalAlignment="Top" Width="Auto" Grid.Column="3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FlowDirection="LeftToRight" Padding="5" />
            <TextBox Height="Auto" FontFamily="Seqoe UI" FontSize="12" HorizontalAlignment="Stretch" Margin="10,10,0,0" Name="txtTime" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" Grid.Column="2" MinWidth="40" MinHeight="25" VerticalContentAlignment="Center" Padding="1" />
            <Button Content="->" FontFamily="Seqoe UI" FontSize="12" Height="Auto" HorizontalAlignment="Left" Margin="3,7,0,0" Name="btnGift" VerticalAlignment="Top" Width="Auto" Click="btnGift_Click" Style="{StaticResource ButtonStyle2}" Grid.Column="1" MinWidth="28" MinHeight="30" />
            <Label Content="مقایسه" FontFamily="Seqoe UI" FontSize="14" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="1,1,0,0" Name="label2" VerticalAlignment="Stretch" VerticalContentAlignment="Top" Width="Auto" Grid.Row="3" Grid.Column="3" />
            <TextBox Height="Auto" FontFamily="Seqoe UI" FontSize="14" HorizontalAlignment="Stretch" Margin="10,5,0,5" Name="txtNumberPicForSimilar" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" Grid.Row="3" Grid.Column="2" MinWidth="40" MinHeight="25" VerticalContentAlignment="Center" Padding="1" />
            <TextBox Height="Auto" FontFamily="Seqoe UI" FontSize="14" HorizontalAlignment="Stretch" Margin="5,10,2,0" Name="txtGift" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" MinWidth="35" MinHeight="25" VerticalContentAlignment="Center" Padding="1" />
        </Grid>
        <Grid Grid.ColumnSpan="3" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="gridImage" VerticalAlignment="Bottom" Visibility="Visible" Grid.Row="3" MouseDown="gridImage_MouseDown" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Grid.Column="7" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image1" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="6" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image2" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="5" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image3" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="4" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image4" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="3" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image5" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="2" Height="Auto" HorizontalAlignment="Center" Margin="4,5,0,5" Name="image6" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="7" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image7" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="6" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image8" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="5" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image9" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="4" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image10" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="3" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image11" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="2" Grid.Row="1" Height="Auto" HorizontalAlignment="Center" Margin="4,5,0,5" Name="image12" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="7" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image13" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="6" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image14" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="5" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image15" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="4" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image16" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="3" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="5" Name="image17" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
            <Image Grid.Column="2" Grid.Row="2" Height="Auto" HorizontalAlignment="Center" Margin="4,5,0,5" Name="image18" Stretch="Fill" VerticalAlignment="Center" Width="Auto" MinWidth="85" MinHeight="85" />
        </Grid>
    </Grid>
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFE6D6A0" Offset="0" />
            <GradientStop Color="#FFD0D1E4" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
</Window>
