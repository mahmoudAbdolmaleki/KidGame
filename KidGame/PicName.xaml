<Window x:Class="KidGame.PicName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PicName" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Closing="Window_Closing" MinWidth="657" MinHeight="565" Left="Auto" mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FlowDirection="LeftToRight" Width="657" Height="565" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFF8F8A9" Offset="0" />
            <GradientStop Color="#FFB3C9E2" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid Name="gridMaster" Margin="35,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="230*" />
            <ColumnDefinition Width="127*" />

            <ColumnDefinition Width="222*" />



        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition Height="200*" />
            <RowDefinition Height="32*" />
            <RowDefinition Height="273*" />
            <RowDefinition Height="19*" />
        </Grid.RowDefinitions>
        <Grid Name="gridImage" Visibility="Visible" Grid.Row="3" Grid.ColumnSpan="3" MouseDown="gridImage_MouseDown" MaxWidth="810" MaxHeight="382">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="91*" />

                <ColumnDefinition Width="91*" />
                <ColumnDefinition Width="91*" />
                <ColumnDefinition Width="91*" />
                <ColumnDefinition Width="91*" />
                <ColumnDefinition Width="91*" />
                <ColumnDefinition Width="16*"/>

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>

                <RowDefinition Height="107*" />
                <RowDefinition Height="91*"/>
                <RowDefinition Height="91*" />


            </Grid.RowDefinitions>
            <Image Grid.Column="1" Margin="3"  Name="image1" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="2" Margin="3"  Name="image2" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="3" Margin="3"  Name="image3" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="4" Margin="3"  Name="image4" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="5" Margin="3"  Name="image5" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="6" Margin="3"  Name="image6" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="1" Grid.Row="1" Margin="3"  Name="image7" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="2" Grid.Row="1" Margin="3"  Name="image8" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="3" Grid.Row="1" Margin="3"  Name="image9" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="4" Grid.Row="1" Margin="3"  Name="image10" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="5" Grid.Row="1" Margin="3"  Name="image11" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="6" Grid.Row="1" Margin="3"  Name="image12" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="1" Grid.Row="2" Margin="3"  Name="image13" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="2" Grid.Row="2" Margin="3"  Name="image14" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="3" Grid.Row="2" Margin="3"  Name="image15" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="4" Grid.Row="2" Margin="3"  Name="image16" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="5" Grid.Row="2" Margin="3"  Name="image17" MinWidth="85" MinHeight="85" Stretch="Fill" />
            <Image Grid.Column="6" Grid.Row="2" Margin="3"  Name="image18" MinWidth="85" MinHeight="85" Stretch="Fill" />
        </Grid>
        <Grid Name="gridStart" Grid.Column="2" Grid.Row="1" MinWidth="222" MinHeight="200" Margin="1,0" Grid.RowSpan="1" MaxWidth="270" MaxHeight="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="101*" />
                <ColumnDefinition Width="121*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="10" />
                <RowDefinition Height="52*" />
                <RowDefinition Height="55*" />
                <RowDefinition Height="70*" />
                <RowDefinition Height="13" />
            </Grid.RowDefinitions>
            <Label Content="نام بازیکن" FontSize="18" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="20,10,14,10" Name="label1" Width="Auto" HorizontalContentAlignment="Center" Padding="3" Grid.Row="1" VerticalContentAlignment="Center" />
            <TextBlock  FontSize="18" Foreground="#FF1453E2" Height="Auto" HorizontalAlignment="Stretch" Name="txtbNamePlayer" Text="Name" TextAlignment="Right" Width="Auto" Padding="2" Margin="10" Grid.Row="1" />
            <Button Click="btnStartGame_Click" Content="شروع بازی" Grid.Column="1" Grid.Row="2" Height="Auto" Name="btnStartGame" Style="{StaticResource ButtonStyle2}" Margin="10,10,8,2" FontSize="18" Padding="1" MinHeight="37" MinWidth="80" MaxWidth="120" MaxHeight="50" />
            <Grid Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left" Margin="10,0,0,0" Name="gridRdioBtn" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="33" />
                    <RowDefinition Height="33" />
                </Grid.RowDefinitions>
                <RadioButton Checked="radibtnNormal_Checked" Content="سخت" IsChecked="False" Margin="6" Name="radibtnNormal" Grid.Row="1" FontSize="14" Padding="0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" />
                <RadioButton Checked="radibtnEasy_Checked" Content="ساده" IsChecked="False" IsEnabled="True" Margin="6,6,6,0" Name="radibtnEasy" Padding="0" VerticalAlignment="Top" FontSize="14" Height="21" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom" />
            </Grid>
            <Label Content="انصراف" FontSize="18" Foreground="#FFCB1212" Grid.Row="2" Margin="10" MouseDown="lblCancel_MouseDown" Name="lblCancel" VerticalContentAlignment="Center" MouseWheel="lblCancel_MouseWheel" MouseEnter="lblCancel_MouseEnter" MouseLeave="lblCancel_MouseLeave" FontStyle="Normal" MinWidth="81" MinHeight="35" HorizontalAlignment="Right" FontWeight="Bold" Padding="2,5,5,5" HorizontalContentAlignment="Right" />
        </Grid>
        <Grid Name="gridScore" VerticalAlignment="Stretch" Grid.Row="1" MaxWidth="270" MaxHeight="240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="43*" />
                <ColumnDefinition Width="32*" />
                <ColumnDefinition Width="56*" />
                <ColumnDefinition Width="99*" />

            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20" />
                <RowDefinition Height="13*" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="12*" />
                <RowDefinition Height="33" />
            </Grid.RowDefinitions>
            <Label Content="دور" Height="Auto" Margin="0" Name="lblRound" VerticalContentAlignment="Top" Width="Auto" Grid.Column="3" Grid.Row="4" FontSize="16" HorizontalContentAlignment="Center" MaxWidth="99" MaxHeight="36" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="3" Name="txtScore" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="2" MinWidth="50" MinHeight="30" VerticalContentAlignment="Center" Padding="1" MaxWidth="50" MaxHeight="30" />
            <Label Content="امتیاز" Margin="10,1" Name="lblScore" Grid.Column="3" Grid.Row="2" FontSize="16" HorizontalContentAlignment="Center" MaxWidth="79" MaxHeight="34" />
            <TextBox HorizontalAlignment="Stretch" IsReadOnly="True" Margin="3" Name="txtRound" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="4" MinWidth="50" MinHeight="30" Height="Auto" VerticalContentAlignment="Center" Padding="1" MaxWidth="50" MaxHeight="30" />
            <TextBox Height="Auto" IsReadOnly="True" Margin="3,3,3,5" Name="txtTime" Grid.Column="2" Grid.Row="1" VerticalContentAlignment="Center" Padding="1" MaxWidth="50" MaxHeight="31" />
            <Button Click="btnGift_Click" Content="-&gt;" HorizontalAlignment="Stretch" Margin="2,4,2,5" Name="btnGift" VerticalAlignment="Stretch" Style="{StaticResource ButtonStyle2}" Grid.Row="1" Grid.Column="1" MinWidth="28" MinHeight="30" MaxWidth="28" MaxHeight="30" />
            <Label Content="مقایسه" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" Name="label2" VerticalContentAlignment="Top" Width="Auto" Grid.Column="3" Grid.Row="3" FontSize="16" MaxWidth="99" MaxHeight="36" />
            <TextBox Height="Auto" HorizontalAlignment="Stretch" IsReadOnly="True" Margin="3" Name="txtNumberPicForSimilar" VerticalAlignment="Stretch" Width="Auto" Grid.Column="2" Grid.Row="3" MinWidth="50" MinHeight="30" VerticalContentAlignment="Center" Padding="1" MaxWidth="50" MaxHeight="30" />
            <TextBox  HorizontalAlignment="Stretch" IsReadOnly="True" Margin="2,4,2,5" Name="txtGift" VerticalAlignment="Center" Width="Auto" Grid.Row="1" MinHeight="30" MinWidth="39" VerticalContentAlignment="Center" Padding="1" MaxWidth="39" MaxHeight="30" />
            <Label Content="زمان باقیمانده" Height="Auto" HorizontalAlignment="Stretch" Name="lblTime" VerticalAlignment="Stretch" Grid.Column="3" Grid.Row="1" FontSize="16" Padding="2" VerticalContentAlignment="Center" Grid.RowSpan="1" Width="Auto" HorizontalContentAlignment="Center" MaxWidth="105" MaxHeight="39" />
        </Grid>
        <TextBlock Margin="0,73,0,27" Name="TxtBlChangeName" Text="" FontSize="28" Foreground="#FF0C0C5F" FlowDirection="RightToLeft" TextAlignment="Center" Padding="2" Grid.Row="1" MinWidth="127" MinHeight="100" TextWrapping="WrapWithOverflow" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
    </Grid>
</Window>
