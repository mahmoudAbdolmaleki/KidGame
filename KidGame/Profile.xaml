<Window x:Class="KidGame.Profile"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Height="300" Width="300" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed" Closing="Window_Closing">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEAA2A2" Offset="0" />
            <GradientStop Color="#FF8B7D7D" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38*" />
            <RowDefinition Height="182" />
            <RowDefinition Height="41*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*" />
            <ColumnDefinition Width="145" />
            <ColumnDefinition Width="68*" />
        </Grid.ColumnDefinitions>
        <Grid Name="gridSave" Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36*" />
                <RowDefinition Height="28*" />
                <RowDefinition Height="40*" />
                <RowDefinition Height="30*" />
                <RowDefinition Height="54*" />
            </Grid.RowDefinitions>
            <TextBox Height="Auto" HorizontalAlignment="Stretch" Name="txt_namePlayer" VerticalAlignment="Stretch" Width="Auto" TextAlignment="Right" FontSize="18"  />
        <Button Content="ثبت بازیکن" Height="Auto" HorizontalAlignment="Stretch" Margin="4,2" Name="btn_createPlayer" VerticalAlignment="Stretch" Width="Auto" FontSize="16" Click="btn_createPlayer_Click" Style="{StaticResource ButtonStyle2}" Grid.Row="2" />
        <Button Content="حذف بازیکن" Height="27" HorizontalAlignment="Center" Name="btnDeletePlayer" VerticalAlignment="Center" Width="75" ClickMode="Release" Margin="0" Click="btnDeletePlayer_Click" Style="{StaticResource ButtonStyle2}" Grid.Row="4" />
</Grid>

    </Grid>
</Window>
